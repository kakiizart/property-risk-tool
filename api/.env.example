# --- App ---
APP_NAME=property-risk-api
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:3000

# --- Database: Supabase Postgres connection string (leave blank until provisioned) ---
# Use the "Session pooler" string from Supabase (Connect button) — it works over IPv4:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Auth: Supabase JWT verification (leave blank until provisioned) ---
# Project URL, e.g. https://<project-ref>.supabase.co. Not a secret. Used to fetch the
# public signing keys (JWKS) that verify sign-ins on projects created since Oct 2025.
SUPABASE_URL=
# Optional, older projects only: the legacy HS256 secret
# (Project Settings > JWT Keys > Legacy JWT Secret). Leave blank on new projects.
# With neither value set, auth-protected endpoints (saved reports) return 503.
SUPABASE_JWT_SECRET=
# Expected audience claim on Supabase access tokens (default for signed-in users).
SUPABASE_JWT_AUDIENCE=authenticated

# --- External data services (defaults are correct; override only if needed) ---
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder
NFHL_MAPSERVER_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer

# --- Outbound HTTP ---
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=1
