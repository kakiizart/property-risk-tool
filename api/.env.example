# --- App ---
APP_NAME=property-risk-api
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:3000

# --- Database: Supabase Postgres connection string (leave blank until provisioned) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# --- Auth: Supabase JWT verification (leave blank until provisioned) ---
# HS256 secret from Supabase: Project Settings > API > JWT Settings > "JWT Secret".
# Auth-protected endpoints (saved reports) return 503 when unset.
SUPABASE_JWT_SECRET=
# Expected audience claim on Supabase access tokens (default for signed-in users).
SUPABASE_JWT_AUDIENCE=authenticated

# --- External data services (defaults are correct; override only if needed) ---
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder
NFHL_MAPSERVER_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer

# --- Outbound HTTP ---
HTTP_TIMEOUT_SECONDS=8.0
HTTP_MAX_RETRIES=1
