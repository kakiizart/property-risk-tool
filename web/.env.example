# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase Auth (optional) ---
# Leave both blank to run without auth: public report lookups still work and the
# saved-report UI hides itself. Set both to enable sign-in + saved reports.
# From Supabase: Project Settings > API Keys. Use the publishable key (sb_publishable_...)
# or the legacy anon key; either is safe to expose to the browser. Never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
